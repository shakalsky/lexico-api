# Differs from development (3000), so both can run at once.
PORT=3001
HOST=0.0.0.0
# Matches the db-staging Postgres container in compose.yaml.
DATABASE_URL=postgres://lexico:lexico@localhost:5432/lexico
# Comma-separated list of origins allowed to call the API (lexico-web dev server).
CORS_ORIGIN=http://localhost:5173
